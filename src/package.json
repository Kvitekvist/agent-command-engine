{
  "name": "agent-command-engine",
  "version": "0.1.22",
  "description": "A specialized Electron interface for managing Claude & OpenAI Codex agents across multiple projects",
  "main": "dist/main/index.js",
  "author": "Jens",
  "scripts": {
    "postinstall": "node scripts/fix-pty-perms.js",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite --config vite.renderer.config.mjs",
    "dev:main": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build --config vite.renderer.config.mjs",
    "build:main": "node scripts/build-main.js",
    "build": "npm run build:renderer && npm run build:main",
    "package": "npm run build && electron-builder",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.50.0",
    "node-pty": "^1.1.0",
    "recharts": "^2.12.7",
    "sql.js": "^1.12.0",
    "tokscale": "^4.9.0",
    "vite-plugin-monaco-editor-esm": "^2.0.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.ace.app",
    "productName": "Agent Command Engine",
    "npmRebuild": false,
    "publish": null,
    "afterAllArtifactBuild": "build/afterAllArtifactBuild.js",
    "directories": {
      "output": "../releases"
    },
    "files": [
      "dist/**/*",
      "node_modules/sql.js/**/*",
      "node_modules/tokscale/**/*",
      "node_modules/@tokscale/**/*",
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "main/project-template",
        "to": "project-template"
      }
    ],
    "asarUnpack": [
      "node_modules/tokscale/**/*",
      "node_modules/@tokscale/**/*",
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "icon": "../build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "../build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  }
}
