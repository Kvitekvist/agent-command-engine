{
  "name": "claude-projects-interface",
  "version": "0.1.1",
  "description": "A specialized Electron interface for managing Claude & OpenAI Codex agents across multiple projects",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite --config vite.renderer.config.mjs",
    "dev:main": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build --config vite.renderer.config.mjs",
    "build:main": "node scripts/build-main.js",
    "build": "npm run build:renderer && npm run build:main",
    "package": "npm run build && electron-builder",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "recharts": "^2.12.7",
    "sql.js": "^1.12.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.cpi.app",
    "productName": "Claude Projects Interface",
    "directories": {
      "output": "../releases"
    },
    "files": [
      "dist/**/*",
      "node_modules/sql.js/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
